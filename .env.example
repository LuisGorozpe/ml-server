# .env.example — Copy to .env and edit values before running docker compose

# Build-time args (used in docker-compose build args)
BASE_IMAGE=ophub/armbian-bookworm    # or debian:bookworm-slim for x86
ARCH=arm64                           # arm64 or amd64

# Service ports
JUPYTER_PORT=8888
MLFLOW_PORT=5000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CODE_SERVER_PORT=8080

# MinIO (S3) credentials (example values — CHANGE for real deployments)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniopass

# MLflow configuration
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=s3://mlflow/

# Other optional variables
# e.g. JUPYTERHUB_ADMIN=adminuser
# Note: Do NOT commit .env with real secrets to your VCS
